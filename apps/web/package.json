{
  "name": "@narralume/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "bundle": "vite build",
    "bundle:spike": "vite build --config vite.spike.config.ts",
    "dev": "vite --host 127.0.0.1 --port 4318",
    "preview": "vite preview --host 127.0.0.1 --port 4318",
    "preview:spike": "vite preview --config vite.spike.config.ts --host 127.0.0.1 --port 4319",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@narralume/contracts": "^0.2.0",
    "@narralume/harness": "^0.2.0",
    "@narralume/narrative": "^0.2.0",
    "@narralume/persistence": "0.2.0",
    "@narralume/services": "^0.2.0",
    "@tanstack/react-query": "^5.101.4",
    "dompurify": "^3.4.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1"
  }
