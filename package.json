{
  "name": "narralume",
  "version": "0.2.0",
  "private": true,
  "description": "NarraLume (叙灯) is a local-first, recoverable AI long-form fiction studio.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false && npm run bundle -w @narralume/web",
    "dev:bridge": "npm run dev -w @narralume/bridge",
    "deploy:relay": "npm run deploy -w @narralume/relay",
    "deploy:web": "node scripts/deploy-web.mjs",
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev -w @narralume/server\" \"npm run dev -w @narralume/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:bridge-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-bridge-task.ps1",
    "release:build": "node scripts/build-release.mjs",
    "lint": "eslint . --max-warnings=0",
    "licenses:check": "node scripts/check-licenses.mjs --check",
    "licenses:update": "node scripts/check-licenses.mjs --write",
    "test": "vitest run",
    "pretest:e2e": "npm run build && npm run bundle:spike -w @narralume/web",
    "test:e2e": "playwright test",
    "test:golden": "vitest run packages/persistence/test/long-novel-golden.test.ts",
    "test:evidence": "tsx scripts/evidence-protocol-eval.ts",
    "test:coverage": "vitest run --coverage",
    "test:real": "tsx scripts/llm-real-smoke.ts",
    "test:real:bridge": "tsx scripts/bridge-real-smoke.ts",
    "test:real:bridge-public": "tsx scripts/bridge-public-real-smoke.ts",
    "test:real:capabilities": "tsx scripts/llm-real-smoke.ts",
    "test:real:chapter": "tsx scripts/chapter-real-smoke.ts",
    "test:real:autopilot": "tsx scripts/autopilot-real-smoke.ts",
    "test:real:studio": "tsx scripts/studio-real-smoke.ts",
    "test:real:delivery": "tsx scripts/delivery-real-smoke.ts",
    "seed:example": "tsx scripts/seed-example.ts",
    "start:bridge": "npm run start -w @narralume/bridge",
    "typecheck": "tsc -b --pretty false && tsc -p scripts/tsconfig.json --noEmit --pretty false",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:evidence && npm run licenses:check && npm run build",
    "verify:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:evidence && npm run licenses:check",
    "verify:release": "npm run verify:ci && npm run test:e2e && npm run test:real"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
